{
  "name": "victor-marti-site-otel",
  "private": true,
  "description": "Bundle OpenTelemetry navigateur du site (généré dans ../otel.js)",
  "type": "module",
  "scripts": {
    "build": "esbuild src/otel.js --bundle --minify --format=esm --target=es2020 --legal-comments=none --outfile=../otel.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-document-load": "0.69.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/web-common": "0.300.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.44.0"
  }
}
